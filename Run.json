{
  "name": "Run",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "Reference to the building"
    },
    "runner_name": {
      "type": "string",
      "description": "Name of the runner"
    },
    "runner_email": {
      "type": "string",
      "description": "Email of the runner"
    },
    "time_seconds": {
      "type": "number",
      "description": "Run time in seconds"
    },
    "floors_reached": {
      "type": "number",
      "description": "Number of floors reached"
    },
    "category": {
      "type": "string",
      "enum": [
        "any_percent",
        "full_clear",
        "no_elevator",
        "stairs_only",
        "freestyle"
      ],
      "description": "Run category"
    },
    "video_url": {
      "type": "string",
      "description": "Video proof URL"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo evidence URLs"
    },
    "route_waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Ordered route waypoints mapped by the runner"
    },
    "notes": {
      "type": "string",
      "description": "Runner notes"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the run has been verified by admin"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if rejected"
    }
  },
  "required": [
    "building_id",
    "runner_name",
    "time_seconds"
  ]
}
